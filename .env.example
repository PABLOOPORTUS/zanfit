# Copia este archivo como .env (no se sube a git) para probar la IA con `npm run dev`.
# En Vercel, la misma variable va en Settings → Environment Variables.
GEMINI_API_KEY=
# Opcional: modelos de Gemini en orden de preferencia, separados por comas
# (por defecto gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash).
# GEMINI_MODEL=
# Clave service_role de Supabase (Project Settings → API). SOLO para api/registro; nunca con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
